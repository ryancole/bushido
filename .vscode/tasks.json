{
    "version": "2.0.0",
    "options": {
        "shell": {
            "executable": "cmd.exe",
            "args": ["/s", "/c"]
        }
    },
    "tasks": [
        {
            "label": "configure",
            "type": "shell",
            "command": "\"\"C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat\" && set \"VULKAN_SDK=C:\\VulkanSDK\\1.4.350.0\" && cmake --preset msvc-debug\"",
            "problemMatcher": []
        },
        {
            "label": "build",
            "type": "shell",
            "command": "\"\"C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat\" && cmake --build --preset msvc-debug\"",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run",
            "type": "shell",
            "command": "\"\"${workspaceFolder}\\build\\bushido.exe\"\"",
            "dependsOn": "build",
            "problemMatcher": []
        }
    ]
}
